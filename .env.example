# Teleblock Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── FastAGI Server ──────────────────────────────────────
AGI_HOST=127.0.0.1
AGI_PORT=4573

# ── Asterisk AMI (local only) ───────────────────────────
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=teleblock
AMI_SECRET=changeme

# ── Grandstream HT813 ───────────────────────────────────
HT813_IP=192.168.42.145
SIP_PEER_NAME=ht813-fxo
SIP_USERNAME=ht813-fxo
SIP_PASSWORD=change-me

# ── DTMF Challenge ─────────────────────────────────────
CHALLENGE_DIGIT=1
CHALLENGE_TIMEOUT_MS=8000
CHALLENGE_PROMPT=teleblock/challenge     # path under Asterisk sounds dir

# ── Database ───────────────────────────────────────────
DB_PATH=/var/lib/teleblock/calls.db

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=/var/log/teleblock/teleblock.log

# ── Call Retention ─────────────────────────────────────
CALL_RETENTION_DAYS=90
