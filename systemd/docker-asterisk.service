[Unit]
Description=Teleblock Asterisk Container
Documentation=https://github.com/asterisk/asterisk
Wants=network-online.target
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
RemainAfterExit=no
WorkingDirectory=/opt/teleblock/app
# Build during deployment, never during boot. The device must start offline.
ExecStartPre=/usr/bin/docker image inspect --format={{.Id}} teleblock-asterisk:20
ExecStart=/usr/bin/docker compose --ansi never up --no-build
ExecStop=/usr/bin/docker compose --ansi never down
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
